# Model provider - Anthropic direct or via Azure AI Foundry
ANTHROPIC_API_KEY=sk-ant-...

# Agent model (mini-class default; override per run for the frontier ceiling run)
AGENT_MODEL=claude-haiku-4-5-20251001
JUDGE_MODEL=claude-sonnet-5

# Langfuse (self-hosted or free cloud tier - https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# BIRD Mini-Dev local paths (populated by scripts/fetch_bird_data.py)
BIRD_DATA_DIR=./data/minidev/MINIDEV
